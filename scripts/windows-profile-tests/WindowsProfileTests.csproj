<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../windows/App.xaml.cs" Link="App.cs" />
    <Compile Include="../../windows/StartupService.cs" Link="StartupService.cs" />
    <Compile Include="../../windows/WindowsShellTrace.cs" Link="WindowsShellTrace.cs" />
    <Compile Include="../../windows/WindowsCloudFiles.cs" Link="WindowsCloudFiles.cs" />
    <Compile Include="../../windows/WindowsCloudFiles.Interop.cs" Link="WindowsCloudFiles.Interop.cs" />
    <Compile Include="../../windows/WindowsProfileEnvironment.cs" Link="WindowsProfileEnvironment.cs" Condition="Exists('../../windows/WindowsProfileEnvironment.cs')" />
  </ItemGroup>
</Project>
