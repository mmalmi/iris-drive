<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IrisDrive</AssemblyName>
    <RootNamespace>IrisDrive.WindowsShell</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>8.0.26</RuntimeFrameworkVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>IrisDrive.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The app reports and update-checks the workspace release version from the root Cargo.toml. -->
  <PropertyGroup>
    <IrisDriveWorkspaceCargoToml>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'Cargo.toml'))</IrisDriveWorkspaceCargoToml>
    <IrisDriveWorkspaceVersion Condition="Exists('$(IrisDriveWorkspaceCargoToml)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(IrisDriveWorkspaceCargoToml)')), '(?m)^\[workspace\.package\][\s\S]*?^version\s*=\s*"[^"\r\n]+"'))</IrisDriveWorkspaceVersion>
    <IrisDriveWorkspaceVersion>$([System.Text.RegularExpressions.Regex]::Match('$(IrisDriveWorkspaceVersion)', '[^"]+(?="\z)'))</IrisDriveWorkspaceVersion>
    <Version>$(IrisDriveWorkspaceVersion)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="IrisDriveRequireWorkspaceVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(IrisDriveWorkspaceVersion)' == ''" Text="Could not read [workspace.package] version from $(IrisDriveWorkspaceCargoToml)." />
  </Target>

  <ItemGroup>
    <Content Include="IrisDrive.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="IrisDrive.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\target\debug\iris_drive_app_core.dll" Link="iris_drive_app_core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(Configuration)' == 'Debug' And Exists('..\target\debug\iris_drive_app_core.dll')" />
  </ItemGroup>
</Project>
